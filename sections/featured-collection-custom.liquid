{% comment %}
  Featured collection (custom layout)
  Pick a collection, choose a standard grid or a "featured first" layout
  where the first product is shown larger.
{% endcomment %}

{% stylesheet %}
  .fcc { padding: 48px 0; }
  .fcc__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }
  .fcc__heading { margin: 0; }
  .fcc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fcc__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .fcc__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: rgba(128, 128, 128, 0.12);
  }
  .fcc__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .fcc__link:hover .fcc__media img { transform: scale(1.04); }
  .fcc__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 1;
    padding: 4px 10px;
    border-radius: 999px;
    background: #1a1a1a;
    color: #fff;
    font-size: 1.2rem;
  }
  .fcc__info { padding-top: 12px; }
  .fcc__title { margin: 0 0 4px; font-size: 1.5rem; }
  .fcc__price { margin: 0; font-size: 1.4rem; }
  .fcc__price s { opacity: 0.6; margin-left: 6px; }
  @media (min-width: 750px) {
    .fcc__grid { grid-template-columns: repeat(var(--fcc-cols), 1fr); }
    .fcc--featured .fcc__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .fcc--featured .fcc__item:first-child .fcc__media {
      aspect-ratio: auto;
      flex: 1;
      min-height: 0;
    }
  }
{% endstylesheet %}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<div class="fcc fcc--{{ section.settings.layout }}" style="--fcc-cols: {{ section.settings.columns }};">
  <div class="page-width">
    <div class="fcc__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="fcc__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if collection != blank and section.settings.show_view_all -%}
        <a href="{{ collection.url }}">View all</a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <ul class="fcc__grid" role="list">
        {%- for product in collection.products limit: limit -%}
          <li class="fcc__item">
            <a href="{{ product.url }}" class="fcc__link">
              <div class="fcc__media">
                {%- if product.available == false -%}
                  <span class="fcc__badge">Sold out</span>
                {%- elsif product.compare_at_price > product.price -%}
                  <span class="fcc__badge">Sale</span>
                {%- endif -%}
                {%- if product.featured_image -%}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 500, 700, 900',
                      sizes: '(min-width: 750px) 30vw, 50vw',
                      alt: product.featured_image.alt
                  }}
                {%- endif -%}
              </div>
              <div class="fcc__info">
                <h3 class="fcc__title">{{ product.title | escape }}</h3>
                <p class="fcc__price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}
                    <s>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </p>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p>Select a collection with products in the section settings.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom collection grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brew better at home"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Standard grid" },
        { "value": "featured", "label": "Featured first (large first product)" }
      ],
      "default": "featured"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom collection grid"
    }
  ]
}
{% endschema %}
